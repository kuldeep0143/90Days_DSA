
  class Solution {
    //Recursive TC => 0(n) & SC => 0(n)
    public ListNode reverseList(ListNode head) {
        if (head == null || head.next == null) {
            return head;
        }
        ListNode reverseLL = reverseList(head.next);
        head.next.next = head;
        head.next = null;

        return reverseLL;
    }
    //Iterative TC => 0(n) & SC => 0(1)
    public ListNode reverseList(ListNode head) {
        ListNode cur = head;
        ListNode prev = null;
        ListNode temp = null;
        while (cur != null) {
            temp = cur.next;
            cur.next = prev;
            prev = cur;
            cur = temp;
        }
        return prev;
    }
}

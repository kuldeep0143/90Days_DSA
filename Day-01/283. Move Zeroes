283. Move Zeroes
// Brute force TC = O(n) & SC O(n)
  class Solution {
    public void moveZeroes(int[] nums) {
        int[] temp = new int[nums.length];
        int idx = 0;

        for (int num : nums) {
            if (num != 0) {
                temp[idx++] = num;
            }
        }
        for (int i = 0; i < nums.length; i++) {
            nums[i] = temp[i];
        }
    }
}
//Optimized TC = O(n) & SC = O(1)
class Solution {
    public void moveZeroes(int[] nums) {
        int idx = 0;
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != 0) {
                int temp = nums[i];
                nums[i] = nums[idx];
                nums[idx] = temp;
                idx++;
            }
        }

    }
}

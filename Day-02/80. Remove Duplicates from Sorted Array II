// Brute force TC = O(n) & SC O(n)
class Solution {
    public int removeDuplicates(int[] nums) {
        int k = 0;
        int[] temp = new int[nums.length];
        temp[k++] = nums[0];
        int count = 1;

        for (int i = 1; i < nums.length; i++) {
            if (nums[i] == nums[i - 1]) {
                count++;
            } else {
                count = 1;
            }
            if (count <= 2) {
                temp[k] = nums[i];
                k++;
            }
        }
        for (int i = 0; i < nums.length; i++) {
            nums[i] = temp[i];
        }
        return k;
    }
}

//Optimized TC = O(n) & SC = O(1)
class Solution {
    public int removeDuplicates(int[] nums) {
        int n = nums.length;
        if (n < 2)
            return n;
        int k = 2;
        for (int i = 2; i < n; i++) {
            if (nums[i] != nums[k - 2]) {
                nums[k] = nums[i];
                k++;
            }
        }
        return k;
    }
}
